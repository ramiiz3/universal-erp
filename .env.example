# Local Supabase development values. Use the experimental CLI v3 Native Runtime.
# Run `npx supabase status` to obtain local API values.
# These VITE_ variables are public browser configuration, not secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY

# Never add a service-role key, Supabase secret key, database password, or other
# server secret to a VITE_ variable or committed environment file.
# Configure production values in a separate project and hosting environment.
