# Separate production Supabase project: set these in the deployment platform.
# The URL and publishable key are public client configuration. Never use a
# service-role key, Supabase secret key, or any server credential here.
VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY
